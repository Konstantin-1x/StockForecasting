DB_NAME=stockforecasting
DB_USERNAME=stockforecasting
DB_PASSWORD=admin

SERVER_PORT=8080
TZ=Europe/Moscow
JAVA_OPTS=-Xms512m -Xmx2g -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8

DB_POOL_MAX_SIZE=70
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=120000
DATA_IMPORT_MAX_FILE_SIZE=2GB
DATA_IMPORT_MAX_REQUEST_SIZE=2GB

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me_admin

WB_CONTINUOUS_SCAN_ENABLED=true
WB_MONITORING_ENABLED=false
WB_BASELINE_ON_STARTUP=true
WB_PROXY_FILE=/app/proxies.txt
WB_PROXY_USERNAME=
WB_PROXY_PASSWORD=
WB_PROXY_SECURE=true
WB_PROXY_ENABLED=true
WB_PROXY_MAX_ATTEMPTS=10
WB_PROXY_FAILURE_COOLDOWN=5m
WB_PROXY_REQUEST_TIMEOUT=8s
WB_PROXY_HEALTH_CHECK_ENABLED=true
WB_PROXY_HEALTH_CHECK_TIMEOUT=2s
WB_PROXY_HEALTH_CHECK_PARALLELISM=32
WB_COOKIE_SWITCH_WINDOW_SIZE=50
WB_COOKIE_SWITCH_MIN_SAMPLES=20
WB_COOKIE_SWITCH_HTTP498_THRESHOLD=0.20
WB_SCAN_PARALLELISM=20
WB_MONITOR_BATCH_SIZE=5000
WB_MONITOR_PARALLELISM=20
WB_SCAN_INITIAL_DELAY_MS=3600000
WB_SCAN_FIXED_DELAY_MS=3600000
WB_MONITOR_INITIAL_DELAY_MS=60000
WB_MONITOR_FIXED_DELAY_MS=3600000
WB_PRODUCT_MEASUREMENT_DELAY=1h
WB_PRODUCT_RATE_LIMIT_RETRY_DELAY=1m
WB_REQUEST_TIMEOUT=20s
WB_REQUEST_DELAY=400ms
WB_LOG_SUCCESSFUL_REQUESTS=true
